{
  "name": "sailing-books",
  "productName": "Sailing Books",
  "version": "1.0.5",
  "description": "Sailing Books — minimal EPUB & audiobook library and reader",
  "main": "main.js",
  "author": "Sailing Books",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "tunnel": "node server/tunnel.js",
    "funnel": "node server/funnel.js",
    "check": "node harness/check-phone.js",
    "check:outside": "node harness/check-from-outside.js",
    "check:books": "electron harness/check-all-books.js",
    "tunnel:fix": "node server/fixed-url.js",
    "build:web": "node web/build.js",
    "deploy": "node web/build.js && vercel deploy --prod",
    "dist": "electron-builder --win",
    "dist-all": "electron-builder -w -m -l",
    "icons:android": "electron tools/make-android-icons.js",
    "apk": "node web/build.js && cap sync android && electron tools/make-android-icons.js && cd android && gradlew.bat assembleRelease",
    "apk:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "music-metadata": "^11.16.1",
    "pdfjs-dist": "^3.4.120"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.sailing.books",
    "productName": "Sailing Books",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "web/**/*",
      "server/**/*",
      "package.json",
      "node_modules/jszip/dist/jszip.min.js",
      "node_modules/pdfjs-dist/build/pdf.js",
      "node_modules/pdfjs-dist/build/pdf.worker.js",
      "node_modules/music-metadata/**/*",
      "node_modules/@borewit/text-codec/**/*",
      "node_modules/@tokenizer/inflate/**/*",
      "node_modules/@tokenizer/token/**/*",
      "node_modules/content-type/**/*",
      "node_modules/debug/**/*",
      "node_modules/file-type/**/*",
      "node_modules/ieee754/**/*",
      "node_modules/media-typer/**/*",
      "node_modules/ms/**/*",
      "node_modules/strtok3/**/*",
      "node_modules/token-types/**/*",
      "node_modules/uint8array-extras/**/*",
      "node_modules/win-guid/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Sailing-Books-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Sailing Books"
    }
  }
}
